      "name": "Pairing",
      "description": {
        "content": "NFC remote pairing - complete a request by tapping a card on a different device.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "e7095b09-fa48-4dfb-a084-e66da348ae7e",
          "name": "Get a pairing token/QR to complete this request on a phone",
          "request": {
            "name": "Get a pairing token/QR to complete this request on a phone",
            "description": {
              "content": "Only for `method:\"nfc\"`. Basic only - the integrator's server rotates the one-time token.\nReturns a high-entropy, short-lived, one-claim pairing token and a deep link / QR the phone\nscans. The phone then calls `/pairing/claim`, receives the request's `clientToken`, and\ndrives the same `/certificate` + `/complete` endpoints.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                ":requestId",
                "pairing"
              ],
              "host": [
                "{{auth-requestId-pairing-Url}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "requestId",
                  "description": "(Required) The `requestId` returned by `POST /auth/requests`."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
